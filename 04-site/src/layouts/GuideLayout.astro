---
// Learn guides. Same frame as PostLayout without the market sign off. Guides are teaching, not calls.
import BaseLayout from './BaseLayout.astro';
import EmailSignup from '../components/EmailSignup.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import Toc from '../components/Toc.astro';
import AuthorCard from '../components/AuthorCard.astro';
import RelatedReading from '../components/RelatedReading.astro';
import { categoryLabels } from '../lib/categories';
interface Props { type?: 'website' | 'article'; jsonLd?: Record<string, unknown>; title: string; subtitle?: string; route?: string[]; updated?: Date; category?: string; readMinutes?: number; headings?: { depth: number; slug: string; text: string }[]; current?: string }
const { type = 'website', jsonLd, title, subtitle, route = [], updated, category, readMinutes, headings = [], current = '' } = Astro.props;
---
<BaseLayout title={title} description={subtitle} narrow type={type} jsonLd={jsonLd}>
  <ScrollProgress />
  <article class="article col">
    {route.length > 0 && (
      <ol class="route" aria-label="Route">{route.map((r) => <li>{r}</li>)}</ol>
    )}
    <h1 class="title">{title}</h1>
    {subtitle && <p class="sub">{subtitle}</p>}
    {updated && readMinutes && <ArticleMeta date={updated} minutes={readMinutes} category={category ? categoryLabels[category] : undefined} />}
    <Toc headings={headings} />
    <div class="prose"><slot /></div>
    <div class="end"><EmailSignup variant="band" id="email-guide" /></div>
    <div class="end"><AuthorCard /></div>
    {current && <RelatedReading current={current} />}
  </article>
</BaseLayout>

<style>
  .end { margin-top: 56px; }
</style>
