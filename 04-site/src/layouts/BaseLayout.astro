---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { site } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SocialRail from '../components/SocialRail.astro';

interface Props {
  title?: string;
  description?: string;
  showFooterSignup?: boolean; // false on the home page
  narrow?: boolean; // reading pages: header lines up with the 760px text column
  type?: 'website' | 'article'; // og:type
  image?: string; // og:image path, defaults to the shared card
  imageAlt?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]; // structured data, rendered as JSON-LD
}
const { title, description = site.tagline, showFooterSignup = true, narrow = false, type = 'website', jsonLd, image = '/og-default-v3.png', imageAlt = site.ogAlt } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// Shell pages and the 404 stay out of search until they are real pages.
const noindex = site.pending.includes(path) || path === '/404';
const ogImage = new URL(image, site.url).href;
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <!-- Must match --page in tokens.css. A meta attribute cannot read a CSS variable. -->
    <meta name="theme-color" content="#141011" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:site" content="@AayushICT" />
    <meta name="twitter:creator" content="@AayushICT" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <Font cssVariable="--astro-source-serif" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--astro-figtree" preload={[{ weight: 600, style: 'normal' }]} />
    <Font cssVariable="--astro-instrument-sans" />
    <Font cssVariable="--astro-jetbrains-mono" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header narrow={narrow} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer showSignup={showFooterSignup} />
    <SocialRail />
    <!-- One live region for confirmations (code copied, signup). Scripts write into it. -->
    <div id="live" class="sr" role="status" aria-live="polite"></div>
    <script>
      // Links that leave the site open in a new tab, so nobody loses this page. In-site links stay in the same tab.
      // /go/ links are our affiliate redirects, so they count as leaving. rel keeps sponsored and nofollow.
      document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
        if (a.target === '_blank' && a.rel.includes('noopener')) return;
        const href = a.getAttribute('href') ?? '';
        if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')) return;
        let leaves = false;
        try { const u = new URL(href, location.href); leaves = u.origin !== location.origin || u.pathname.startsWith('/go/'); } catch { return; }
        if (!leaves) return;
        a.target = '_blank';
        const rel = new Set((a.rel || '').split(/\s+/).filter(Boolean));
        rel.add('noopener');
        a.rel = [...rel].join(' ');
        if (!a.querySelector('.sr-new') && !a.getAttribute('aria-label')) {
          const hint = document.createElement('span');
          hint.className = 'sr sr-new';
          hint.textContent = ' (opens in a new tab)';
          a.append(hint);
        }
      });
    </script>
  </body>
</html>
