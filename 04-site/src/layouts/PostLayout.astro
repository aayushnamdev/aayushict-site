---
// Macro posts. Route pills at the top, sign off at the end, email signup after it.
import { site } from '../config/site';
import BaseLayout from './BaseLayout.astro';
import EmailSignup from '../components/EmailSignup.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
interface Props { title: string; subtitle?: string; route?: string[]; meta?: string; progress?: boolean }
const { title, subtitle, route = [], meta, progress = false } = Astro.props;
---
<BaseLayout title={title} description={subtitle} narrow>
  {progress && <ScrollProgress />}
  <article class="article col">
    {route.length > 0 && (
      <ol class="route" aria-label="Route">{route.map((r) => <li>{r}</li>)}</ol>
    )}
    <h1 class="title">{title}</h1>
    {subtitle && <p class="sub">{subtitle}</p>}
    {meta && <p class="meta">{meta}</p>}
    <div class="prose"><slot /></div>
    <p class="signoff">{site.signOff}</p>
    <div class="end"><EmailSignup variant="band" id="email-post" /></div>
  </article>
</BaseLayout>

<style>
  .signoff { font-family: var(--font-number); font-size: 14px; color: var(--text-muted); padding-top: 18px; border-top: 1px solid var(--line); margin-top: 40px; }
  .end { margin-top: 32px; }
</style>
