---
// Macro posts. Route pills at the top, sign off at the end, email signup after it.
import { site } from '../config/site';
import BaseLayout from './BaseLayout.astro';
import EmailSignup from '../components/EmailSignup.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import Toc from '../components/Toc.astro';
import AuthorCard from '../components/AuthorCard.astro';
import RelatedReading from '../components/RelatedReading.astro';
interface Props { type?: 'website' | 'article'; jsonLd?: Record<string, unknown>; title: string; subtitle?: string; description?: string; route?: string[]; meta?: string; progress?: boolean; signup?: boolean; footerSignup?: boolean; source?: string; signOff?: boolean; image?: string; imageAlt?: string; article?: { date: Date; minutes: number }; headings?: { depth: number; slug: string; text: string }[]; current?: string }
const { type = 'website', jsonLd, title, subtitle, description = subtitle, route = [], meta, progress = false, signup = true, footerSignup = true, source = 'website', signOff = true, image, imageAlt, article, headings = [], current = '' } = Astro.props;
---
<BaseLayout title={title} description={description} showFooterSignup={footerSignup && !signup} narrow type={type} jsonLd={jsonLd} image={image} imageAlt={imageAlt}>
  {progress && <ScrollProgress />}
  <article class="article col">
    {route.length > 0 && (
      <ol class="route" aria-label="Route">{route.map((r) => <li>{r}</li>)}</ol>
    )}
    <h1 class="title">{title}</h1>
    {subtitle && <p class="sub">{subtitle}</p>}
    {article ? <ArticleMeta date={article.date} dateLabel="Published" minutes={article.minutes} /> : meta && <p class="meta">{meta}</p>}
    {article && <Toc headings={headings} title="In this post" />}
    <div class="prose"><slot /></div>
    {signOff && <p class="signoff">{site.signOff}</p>}
    {signup && <div class="end"><EmailSignup variant="band" id="email-post" source={source} /></div>}
    {article && <div class="end"><AuthorCard /></div>}
    {article && current && <RelatedReading current={current} />}
  </article>
</BaseLayout>

<style>
  .signoff { font-family: var(--font-number); font-size: 14px; color: var(--text-muted); padding-top: 18px; border-top: 1px solid var(--line); margin-top: 40px; }
  .end { margin-top: 32px; }
</style>
