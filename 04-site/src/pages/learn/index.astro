---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { published, formatDate } from '../../lib/content';
import { categoryLabels } from '../../lib/categories';

const guides = (await published('learn')).sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
const groups = Object.entries(categoryLabels)
  .map(([slug, label]) => ({ slug, label, items: guides.filter((g) => g.data.category === slug) }))
  .filter((g) => g.items.length > 0);
---
<BaseLayout
  title="Learn"
  description="Guides on prop firms, payouts and trading macro events, with the numbers worked out."
  narrow
>
  <div class="article col">
    <h1 class="title">Learn</h1>
    <p class="sub">Guides on prop firms, payouts and trading macro events. The numbers are worked out.</p>
    {groups.length === 0 ? (
      <p class="empty">First guide coming soon.</p>
    ) : (
      groups.map((g) => (
        <section>
          <h2 class="cat"><a href={`/learn/${g.slug}`}>{g.label}</a></h2>
          <ul class="list">
            {g.items.map((it) => (
              <li>
                <a href={`/learn/${it.id}`}>
                  <span class="name ui">{it.data.title}</span>
                  <span class="desc">{it.data.subtitle}</span>
                  <span class="when ui">Updated {formatDate(it.data.updated)} · {it.data.readMinutes} min read</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    )}
  </div>
</BaseLayout>

<style>
  section { margin-top: 44px; }
  .cat { font-size: 14px; letter-spacing: 0.1em; text-transform: uppercase; font-family: var(--font-number); font-weight: 400; color: var(--rose-text); }
  .cat a { color: inherit; text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  .list { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 14px; }
  .list a {
    display: grid; gap: 6px; padding: 20px 22px; text-decoration: none; color: inherit;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-card);
  }
  @media (hover: hover) { .list a:hover { border-color: var(--wine); } }
  .name { font-size: 22px; line-height: 1.3; color: var(--text-heading); font-weight: 600; }
  .desc { font-size: 17px; line-height: 1.55; color: var(--text-soft); }
  .when { font-size: 14px; color: var(--text-muted); }
  .empty { margin-top: 40px; color: var(--text-soft); }
</style>
