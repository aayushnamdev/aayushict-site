---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { published, formatDate } from '../../../lib/content';
import { categoryLabels } from '../../../lib/categories';

// One page per category that has at least one guide, so /learn/prop-firms is never a 404.
export async function getStaticPaths() {
  const guides = await published('learn');
  const slugs = [...new Set(guides.map((g) => g.data.category))];
  return slugs.map((category) => ({
    params: { category },
    props: { label: categoryLabels[category], items: guides.filter((g) => g.data.category === category) },
  }));
}
const { label, items } = Astro.props;
---
<BaseLayout title={`${label} guides`} description={`Guides on ${label.toLowerCase()}, with the numbers worked out. Plain words, real examples, and the rules checked against the firm's own page.`} narrow>
  <div class="article col">
    <h1 class="title">{label}</h1>
    <p class="sub"><a href="/learn">All guides</a></p>
    <ul class="list">
      {items.map((it) => (
        <li>
          <a href={`/learn/${it.id}`}>
            <span class="name ui">{it.data.title}</span>
            <span class="desc">{it.data.subtitle}</span>
            <span class="when ui">Updated {formatDate(it.data.updated)} · {it.data.readMinutes} min read</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .sub a { display: inline-flex; align-items: center; min-height: 44px; }
  .list { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 14px; }
  .list a {
    display: grid; gap: 6px; padding: 20px 22px; text-decoration: none; color: inherit;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-card);
  }
  @media (hover: hover) { .list a:hover { border-color: var(--wine); } }
  .name { font-size: 22px; line-height: 1.3; color: var(--text-heading); font-weight: 600; }
  .desc { font-size: 17px; line-height: 1.55; color: var(--text-soft); }
  .when { font-size: 14px; color: var(--text-muted); }
</style>
