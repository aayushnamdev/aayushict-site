---
import { render } from 'astro:content';
import GuideLayout from '../../../layouts/GuideLayout.astro';
import { published } from '../../../lib/content';
import { articleLd } from '../../../lib/seo';

// Guides live at src/content/learn/<category>/<slug>.mdx, so the id is "<category>/<slug>".
export async function getStaticPaths() {
  const guides = await published('learn');
  return guides.map((guide) => {
    const [category, ...rest] = guide.id.split('/');
    return { params: { category, slug: rest.join('/') }, props: { guide } };
  });
}
const { guide } = Astro.props;
const { Content } = await render(guide);
const d = guide.data;
---
<GuideLayout
  title={d.title}
  subtitle={d.subtitle}
  route={d.route}
  updated={d.updated}
  type="article"
  jsonLd={articleLd({ title: d.title, description: d.subtitle, path: `/learn/${guide.id}/`, published: d.updated, modified: d.updated })}
>
  <Content />
</GuideLayout>
