---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../../layouts/GuideLayout.astro';

// Guides live at src/content/learn/<category>/<slug>.mdx, so the id is "<category>/<slug>".
export async function getStaticPaths() {
  const guides = await getCollection('learn');
  return guides.map((guide) => {
    const [category, ...rest] = guide.id.split('/');
    return { params: { category, slug: rest.join('/') }, props: { guide } };
  });
}
const { guide } = Astro.props;
const { Content } = await render(guide);
---
<GuideLayout title={guide.data.title} subtitle={guide.data.subtitle} route={guide.data.route} updated={guide.data.updated}>
  <Content />
</GuideLayout>
