---
import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/Band.astro';
import TermTip from '../components/TermTip.astro';
import SideCard from '../components/SideCard.astro';
import ProofChips from '../components/ProofChips.astro';
import GapCards from '../components/GapCards.astro';
import NumberFlip from '../components/NumberFlip.astro';
import ReadingOrder from '../components/ReadingOrder.astro';
import ValueTiles from '../components/ValueTiles.astro';
import EmailSignup from '../components/EmailSignup.astro';
import payout from '../assets/proof/apex-payout-2026-08-12.png';
import { site, person } from '../config/site';

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, description: site.tagline, inLanguage: 'en-IN', publisher: person },
  { '@context': 'https://schema.org', ...person, description: 'Trades Nasdaq futures from India and writes about what the market has already priced in.' },
];

// The home page stays short. The long read is /start-here.
// Copy comes from 03-content/drafts/start-from-zero.md. Lines marked PLACEHOLDER are not in
// Aayush's words yet and are listed in 03-content/front-page/placeholders.md.
---
<BaseLayout showFooterSignup={false} jsonLd={jsonLd}>
  <!-- 1. First screen -->
  <Band>
    <div class="hero">
      <div class="stack left">
        <div class="label">Macro · Futures · From India</div>
        <h1 class="h-hero">Know what's priced in. Trade what changes.</h1>
        <p class="lead">
          I'm Aayush. I trade Nasdaq futures from India. Before every big number, I know what the market already expects, so it's already{' '}
          <TermTip title="Priced in" text="Priced in means the market already expects it. The expected number does not move price. The surprise does.">priced in</TermTip>.
          When the number surprises, I trade it.
        </p>
        <ProofChips
          chips={[{ text: '102 points' }, { text: '4 MNQ' }, { text: 'Apex payout', proof: true }]}
          proofTitle="Apex payout, $1,446"
          proofNote="This is from that week, not one trade. I traded 3 to 4 more days after it."
          proofImage={payout}
          proofAlt="Apex Trader Funding rewards certificate, $1,446, approved on 12 August 2026"
        />
      </div>
      <div class="stack right">
        <!-- PLACEHOLDER: both side cards, not in Aayush's words yet -->
        <SideCard href="/macro" label="The macro side" title="I read the news before the chart">
          NFP, CPI, the Fed.<br />I watch gold and the dollar too. I don't trade them.
        </SideCard>
        <!-- PLACEHOLDER -->
        <SideCard href="/journal" label="The futures side" title="I trade Nasdaq futures">
          Mostly MNQ, on funded accounts. The number gives me direction. The 1 minute chart gives me my entry.
        </SideCard>
      </div>
    </div>
  </Band>

  <!-- 2. The gap -->
  <Band variant="white">
    <div class="stack gap">
      <div class="stack intro">
        <div class="label">The gap</div>
        <!-- PLACEHOLDER: heading and the line under it -->
        <h2 class="h-sec">Most people learn one side.</h2>
        <p class="lead">Some learn only the chart. Some only read the news. Both feel stuck in the same place.</p>
      </div>
      <GapCards
        cards={[
          { title: 'Chart only', text: "You learn setups. FVG, order blocks. But at 6 PM price moves 300 points and you don't know why." },
          { title: 'News only', text: 'You read headlines. Jobs weak, Fed this, Fed that. But nobody shows you the trade.' },
          { title: 'From India', text: "You can't easily trade US futures from here. Prop firms are the way in. I show you which ones, honestly." },
          { title: 'Here', text: 'The number tells me the direction. The chart tells me where to get in. I show you both, on real trades.', highlight: true },
        ]}
      />
      <!-- PLACEHOLDER: punch line -->
      <p class="punch">The money is where they meet. Here is one real night.</p>
    </div>
  </Band>

  <!-- 3. One real night, short. The full story is on /start-here -->
  <Band>
    <div class="split">
      <div class="stack night">
        <div class="label">One real night</div>
        <h2 class="h-sec">Friday 7 August. 6 PM India time.</h2>
        <p>Before the print, ADP came in at <span class="n">44,000</span> against <span class="n">65,000</span>. September hike odds fell from two hikes to one. Gold was up <span class="n">6%</span> on the week.</p>
        <p>I had three scenarios written down the day before. The miss came, and it came big.</p>
        <p><a class="btn" href="/start-here">Read the full night</a></p>
      </div>
      <NumberFlip
        label="NFP · The numbers"
        from={85}
        to={-23}
        unit="K"
        caption="Jobs added. The market expected 85K."
        rows={[
          { label: 'Forecast', value: '85K' },
          { label: 'Previous', value: '20K' },
          { label: 'Unemployment', value: '4.1%' },
        ]}
        directions={[
          { name: 'NQ', direction: 'up' },
          { name: 'Gold', direction: 'up' },
        ]}
      />
    </div>
  </Band>

  <!-- 4. The honest part -->
  <Band variant="wine">
    <div class="halves">
      <div class="stack honest">
        <div class="label">The honest part</div>
        <h2 class="h-sec">This night was rare.</h2>
        <p>Most releases land near the forecast. Price just chops, up and down, and nothing runs.</p>
        <p>Even this night, a lot was already priced in. The room left to run was smaller than usual.</p>
      </div>
      <!-- PLACEHOLDER: the three steps are the draft's wording, not Aayush's yet -->
      <ReadingOrder
        label="Read it in this order"
        steps={[
          { title: 'Start here', text: 'One real night, with the numbers and screenshots. About 7 minutes.', href: '/start-here' },
          { title: 'Macro Desk', text: 'What is priced in before each big release. Scenarios written before the number.', href: '/macro' },
          { title: 'Journal', text: 'My calls and trades after the news. Wins and losses, with numbers.', href: '/journal' },
        ]}
      />
    </div>
  </Band>

  <!-- 5. What you get here -->
  <Band variant="white">
    <div class="stack gap">
      <div class="stack intro">
        <div class="label">What you get here</div>
        <h2 class="h-sec">Everything on this site comes back to one question.</h2>
        <!-- PLACEHOLDER: the four tiles are not in Aayush's words yet -->
        <p class="lead">What is priced in, and what would change it?</p>
      </div>
      <ValueTiles
        tiles={[
          { title: 'Macro Desk', text: 'What is priced in before every big event. Scenarios written before the number.', href: '/macro' },
          { title: 'Learn', text: 'The news and the chart together, in simple words.', href: '/learn' },
          { title: 'Journal', text: 'My real trades. Wins and losses, with numbers.', href: '/journal' },
          { title: 'Start here', text: 'One real night, and how to trade futures from India with prop firms.', href: '/start-here' },
        ]}
      />
    </div>
  </Band>

  <!-- 6. Email, per BUILD-PLAN section 5 -->
  <Band variant="wine">
    <EmailSignup variant="wine" id="email-home" />
  </Band>
</BaseLayout>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 64px; align-items: start; margin-top: -14px; } /* band padding is 110px, the reference hero starts at 96px */
  .left { gap: 24px; }
  .left .lead { max-width: 560px; }
  .right { gap: 16px; padding-top: 30px; }
  .gap { gap: 36px; }
  .intro { gap: 14px; max-width: 680px; }
  .punch { font-family: var(--font-heading); font-weight: 600; font-size: 24px; line-height: 1.3; color: var(--ink); }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) 400px; gap: 64px; align-items: start; }
  .night, .honest { gap: 20px; }
  .night .btn { margin-top: 4px; }
  .halves { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 64px; align-items: center; }
  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; gap: 28px; margin-top: 0; }
    .left { gap: 20px; }
    .right { padding-top: 0; }
    .punch { font-size: 21px; }
    .split, .halves { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
