---
import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/Band.astro';
import SideCard from '../components/SideCard.astro';
import GapCards from '../components/GapCards.astro';
import NumberFlip from '../components/NumberFlip.astro';
import ReadingOrder from '../components/ReadingOrder.astro';
import ValueTiles from '../components/ValueTiles.astro';
import EmailSignup from '../components/EmailSignup.astro';
import ProofStack from '../components/ProofStack.astro';
import SessionsArc from '../components/SessionsArc.astro';
import { Image } from 'astro:assets';
import { site, person } from '../config/site';
import { certificates } from '../config/certificates';
import { paidShort, asOf } from '../config/payouts';

// Drop photos into src/assets/photos. portrait.* is the hero photo. ig-*.* join the proof stack.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const find = (re: RegExp) => Object.entries(photos).filter(([p]) => re.test(p)).sort(([a], [b]) => a.localeCompare(b)).map(([, m]) => m.default);
const portrait = find(/\/portrait\./)[0];
const igPhotos = find(/\/ig-/).map((src, i) => ({
  id: `proof-ig-${i + 1}`,
  src,
  alt: 'Aayush Namdev, from his Instagram',
  caption: 'From my Instagram',
}));
// Newest certificate first, then photos spread between the older ones.
const certs = certificates.filter((c) => c.kind !== 'dashboard');
const stackItems = [...certs.slice(0, 2), ...igPhotos, ...certs.slice(2)];

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: `${site.url}/`, description: site.tagline, inLanguage: 'en-IN', publisher: { '@id': person['@id'] } },
  { '@context': 'https://schema.org', ...person, description: `Trades Nasdaq futures from India. ${paidShort} paid out, with proof. Breaks big trading words into simple steps: ICT, macro news and prop firms.` },
];

// The home page stays short. The long read is /start-here.
// Copy comes from 03-content/drafts/start-from-zero.md. Lines marked PLACEHOLDER are not in
// Aayush's words yet and are listed in 03-content/front-page/placeholders.md.
---
<BaseLayout
  title="Aayush Namdev, Nasdaq futures from India"
  description={`I trade Nasdaq futures from India. ${paidShort} paid out, with proof. I break big trading words into simple steps: ICT, macro news and prop firms.`}
  showFooterSignup={false}
  jsonLd={jsonLd}
>
  <!-- 1. First screen -->
  <Band>
    <div class="hero">
      <div class="stack left">
        <div class="label">Macro · Futures · From India</div>
        <h1 class="h-hero">I'm Aayush. I trade Nasdaq futures from India.</h1>
        <p class="lead">
          <span class="n">{paidShort}</span> paid out so far. Every payout is here, with the proof.
        </p>
        <p class="goal">Trading is full of big words. I break them down into simple steps.</p>
        <ul class="topics" aria-label="What I cover">
          <li>ICT strategies</li>
          <li>Macro news</li>
          <li>Prop firms, evaluation to payout</li>
        </ul>
        <div class="cta">
          <a class="btn" href="/about">About me</a>
          <a class="btn ghost" href="/start-here">Start here</a>
        </div>
      </div>
      <div class="stack right">
        {portrait ? (
          <div class="pframe" data-pframe>
            <div class="pback" aria-hidden="true"></div>
            <figure class="portrait">
              <Image src={portrait} alt="Aayush Namdev" widths={[300, 600, 900]} sizes="(max-width: 860px) 200px, 300px" loading="eager" />
            </figure>
            <p class="ui pname">Aayush Namdev</p>
          </div>
        ) : (
          <>
            <!-- PLACEHOLDER: both side cards, not in Aayush's words yet. Replaced by the photo once portrait.* is added. -->
            <SideCard href="/start-here" label="The macro side" title="I read the news before the chart">
              NFP, CPI, the Fed.<br />I watch gold and the dollar too. I don't trade them.
            </SideCard>
            <SideCard href="/about" label="The futures side" title="I trade Nasdaq futures">
              Mostly MNQ, on funded accounts. The number gives me direction. The 1 minute chart gives me my entry.
            </SideCard>
          </>
        )}
      </div>
    </div>
  </Band>

  <!-- 1b. Proof: the payout stack. Total and certificates come from config, so they stay in sync. -->
  <Band variant="wine">
    <div class="proofband" id="proof">
      <div class="stack proofcopy">
        <div class="label">The proof</div>
        <h2 class="h-sec"><span class="n">{paidShort}</span> paid out so far.</h2>
        <p class="lead">Real payout certificates from Apex and Alpha Capital. Tap the pile to flip through.</p>
        <p class="ui fine">As of {asOf}. <a href="/about">See every payout</a></p>
      </div>
      <ProofStack items={stackItems} />
    </div>
  </Band>

  <!-- 2. The gap -->
  <Band variant="white">
    <div class="stack gap">
      <div class="stack intro">
        <div class="label">The gap</div>
        <!-- PLACEHOLDER: heading and the line under it -->
        <h2 class="h-sec">Most people learn one side.</h2>
        <p class="lead">Some learn only the chart. Some only read the news. Both feel stuck in the same place.</p>
      </div>
      <GapCards
        cards={[
          { title: 'Chart only', icon: 'chart', text: "You learn setups. FVG, order blocks. But at 6 PM price moves 300 points and you don't know why." },
          { title: 'News only', icon: 'news', text: 'You read headlines. Jobs weak, Fed this, Fed that. But nobody shows you the trade.' },
          { title: 'From India', icon: 'pin', text: "You can't easily trade US futures from here. Prop firms are the way in. I show you which ones, honestly." },
          { title: 'Here', icon: 'target', text: 'The number tells me the direction. The chart tells me where to get in. I show you both, on real trades.', highlight: true },
        ]}
      />
      <!-- PLACEHOLDER: punch line -->
      <p class="punch">The money is where they meet. Here is one real night.</p>
    </div>
  </Band>

  <!-- 3. One real night, short. The full story is on /start-here -->
  <Band>
    <div class="split">
      <div class="stack night">
        <div class="label">One real night</div>
        <h2 class="h-sec">Friday 7 August. 6 PM India time.</h2>
        <p>Before the print, ADP came in at <span class="n">44,000</span> against <span class="n">65,000</span>. September hike odds fell from two hikes to one. Gold was up <span class="n">6%</span> on the week.</p>
        <p>I had three scenarios written down the day before. The miss came, and it came big.</p>
        <p><a class="btn" href="/start-here">Read the full night</a></p>
      </div>
      <NumberFlip
        label="NFP · The numbers"
        from={85}
        to={-23}
        unit="K"
        caption="Jobs added. The market expected 85K."
        rows={[
          { label: 'Forecast', value: '85K' },
          { label: 'Previous', value: '20K' },
          { label: 'Unemployment', value: '4.1%' },
        ]}
        directions={[
          { name: 'NQ', direction: 'up' },
          { name: 'Gold', direction: 'up' },
        ]}
      />
    </div>
  </Band>

  <!-- 4. The honest part -->
  <Band variant="wine">
    <div class="halves">
      <div class="stack honest">
        <div class="label">The honest part</div>
        <h2 class="h-sec">This night was rare.</h2>
        <p>Most releases land near the forecast. Price just chops, up and down, and nothing runs.</p>
        <p>Even this night, a lot was already priced in. The room left to run was smaller than usual.</p>
      </div>
      <!-- PLACEHOLDER: the three steps are the draft's wording, not Aayush's yet -->
      <ReadingOrder
        label="Read it in this order"
        steps={[
          { title: 'Start here', text: 'One real night, with the numbers and the macro tool I use. About 7 minutes.', href: '/start-here' },
          { title: 'About me', text: 'Who I am, how I trade, and my payouts so far.', href: '/about' },
          { title: 'The Sunday email', text: 'The week ahead in your inbox. One email, plus big release briefings.', href: '#email-home' },
        ]}
      />
    </div>
  </Band>

  <!-- 5. What you get here -->
  <Band variant="white">
    <div class="stack gap">
      <div class="stack intro">
        <div class="label">What you get here</div>
        <h2 class="h-sec">Everything on this site comes back to one question.</h2>
        <!-- PLACEHOLDER: the four tiles are not in Aayush's words yet -->
        <p class="lead">What is priced in, and what would change it?</p>
      </div>
      <ValueTiles
        tiles={[
          { title: 'Start here', icon: 'flag', text: 'One real night, and how to trade futures from India with prop firms.', href: '/start-here' },
          { title: 'Learn', icon: 'book', text: 'Guides on prop firms and payouts, with the numbers worked out.', href: '/learn' },
          { title: 'MRKT', icon: 'screen', text: 'The macro terminal I open every morning. My code AAYUSH gives you 10% off.', href: '/start-here#mrkt' },
          { title: 'Sunday email', icon: 'mail', text: 'What is priced in for the week ahead. Scenarios written before the number.', href: '#email-home' },
        ]}
      />
    </div>
  </Band>

  <!-- 5b. Coming soon: the next post. Sends people to the teaser, which collects the signups. -->
  <Band>
    <div class="soon">
      <div class="stack soontxt">
        <div class="label">Coming soon</div>
        <h2 class="h-sec">How I trade, every day.</h2>
        <p class="lead">The model behind about 95% of my trades. I will show all of it.</p>
        <p><a class="btn" href="/how-i-trade">Get it first</a></p>
      </div>
      <SessionsArc />
    </div>
  </Band>

  <!-- 6. Email, per BUILD-PLAN section 5 -->
  <Band variant="wine">
    <EmailSignup variant="wine" id="email-home" />
  </Band>
</BaseLayout>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 64px); align-items: start; margin-top: -48px; } /* band padding is 110px, the reference hero starts at 96px */
  .left { gap: 20px; }
  .left .lead { max-width: 560px; }
  .goal { max-width: 560px; font-family: var(--font-body); font-size: 19px; line-height: 1.55; color: var(--text-soft); margin-bottom: -8px; }
  .topics { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .topics li { font-family: var(--font-number); font-size: 13px; line-height: 1.3; padding: 9px 13px; border-radius: var(--radius-button); background: var(--surface); border: 1px solid var(--line); color: var(--text-heading); }
  .right { gap: 16px; padding-top: 30px; }
  /* Photo card: a matted frame with a second card behind it, tilted like the certificate stack. */
  .pframe { --rx: 2deg; --ry: -7deg; position: relative; width: 300px; max-width: 100%; margin: 0 auto; perspective: 900px; }
  .pback { position: absolute; inset: 0 0 34px; border-radius: var(--radius-card); background: var(--surface-raised); border: 1px solid var(--line); transform: rotate(5deg) translate(14px, 6px); z-index: 0; }
  .portrait {
    position: relative; z-index: 1; margin: 0; padding: 10px; background: var(--surface);
    border: 1px solid var(--line-strong); border-radius: var(--radius-card);
    border-right-color: var(--wine); border-bottom: 3px solid var(--wine);
    box-shadow: var(--shadow-pop);
    transform: rotateX(var(--rx)) rotateY(var(--ry)); transition: transform 0.3s ease-out;
  }
  .portrait :global(img) { display: block; width: 100%; height: auto; border-radius: 8px; }
  .pname { position: relative; z-index: 1; margin: 14px 0 0; text-align: center; font-family: var(--font-number); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
  @media (prefers-reduced-motion: reduce) { .portrait { transition: none; } }
  .ghost { background: transparent; border: 1px solid var(--line-strong); color: var(--text-heading) !important; }
  .proofband { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 500px); gap: clamp(32px, 5vw, 64px); align-items: center; }
  .soon { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 460px); gap: clamp(32px, 5vw, 64px); align-items: center; }
  .soontxt { gap: 16px; }
  .proofband { scroll-margin-top: 40px; }
  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 14px; }
  .proofcopy { gap: 16px; }
  .proofcopy .fine { font-size: 14px; color: var(--text-on-wine); }
  .proofcopy .fine a { color: var(--white); }
  .gap { gap: 36px; }
  .intro { gap: 14px; max-width: 680px; }
  .punch { font-family: var(--font-heading); font-weight: 600; font-size: 24px; line-height: 1.3; color: var(--ink); }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 400px); gap: clamp(32px, 5vw, 64px); align-items: start; }
  .night, .honest { gap: 20px; }
  .night .btn { margin-top: 4px; }
  .halves { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(32px, 5vw, 64px); align-items: center; }
  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; gap: 28px; margin-top: 0; }
    .left { gap: 20px; }
    .right { padding-top: 0; }
    .punch { font-size: 21px; }
    .split, .halves, .proofband, .soon { grid-template-columns: 1fr; gap: 32px; }
    .right { order: -1; } /* on phone the photo comes first, it is the personal part */
    .pframe { width: 150px; --ry: -5deg; }
    .goal { font-size: 17px; order: 3; margin-bottom: 0; } /* on a phone the buttons come first, then the line and the tags */
    .topics { order: 4; }
    .cta { order: 1; }
    .pname { display: none; } /* the headline already says the name */
    .left :global(.h-hero) { font-size: 36px; }
    .right { overflow-x: clip; padding-right: 16px; }
  }
</style>

<script>
  const pf = document.querySelector<HTMLElement>('[data-pframe]');
  if (pf && matchMedia('(hover: hover)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    pf.addEventListener('pointermove', (e) => {
      const r = pf.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width - 0.5;
      const py = (e.clientY - r.top) / r.height - 0.5;
      pf.style.setProperty('--rx', `${(2 - py * 10).toFixed(2)}deg`);
      pf.style.setProperty('--ry', `${(-7 + px * 14).toFixed(2)}deg`);
    });
    pf.addEventListener('pointerleave', () => { pf.style.setProperty('--rx', '2deg'); pf.style.setProperty('--ry', '-7deg'); });
  }
</script>
