---
import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/Band.astro';
import EmailSignup from '../components/EmailSignup.astro';
import ProofStack from '../components/ProofStack.astro';
import FollowButton from '../components/FollowButton.astro';
import StickyFollow from '../components/StickyFollow.astro';
import LatestJournal from '../components/LatestJournal.astro';
import { Image } from 'astro:assets';
import { site, person } from '../config/site';
import { certificates, paidShort, asOf, apex2026Count } from '../config/payouts';

// Drop photos into src/assets/photos. portrait.* is the desktop hero photo, portrait-close.* the round phone one.
// ig-*.* join the proof stack. Brief for this page: 00-strategy/homepage-spec-2026-10.md
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const find = (re: RegExp) => Object.entries(photos).filter(([p]) => re.test(p)).sort(([a], [b]) => a.localeCompare(b)).map(([, m]) => m.default);
const portrait = find(/\/portrait\./)[0];
const portraitClose = find(/\/portrait-close\./)[0] ?? portrait;
const igPhotos = find(/\/ig-/).map((src, i) => ({
  id: `proof-ig-${i + 1}`,
  src,
  alt: 'Aayush Namdev, from his Instagram',
  caption: 'From my Instagram',
}));
// Newest certificate first, then photos spread between the older ones. Dashboard crops stay out of the home pile.
const certs = certificates.filter((c) => c.kind !== 'dashboard');
const stackItems = [...certs.slice(0, 2), ...igPhotos, ...certs.slice(2)];

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: `${site.url}/`, description: site.tagline, inLanguage: 'en-IN', publisher: { '@id': person['@id'] } },
  { '@context': 'https://schema.org', ...person, description: `Trades Nasdaq futures from India. ${paidShort} paid out, with proof. Takes prop firm accounts from evaluation to payout, on Instagram.` },
];
---
<BaseLayout
  title="Aayush Namdev, Nasdaq futures from India"
  description={`I trade Nasdaq futures from India. ${paidShort} paid out, with proof. On Instagram I take prop firm accounts from evaluation to payout.`}
  showFooterSignup={false}
  hideRail
  jsonLd={jsonLd}
>
  <!-- 1. Hero. Visitors come from the Instagram bio and want to know who he is, so the main button is About me. Follow is on the About page. The button must be on screen at 375 x 640. -->
  <Band>
    <div class="hero">
      <div class="stack left">
        <div class="top">
          <div class="label">Funded Nasdaq futures trader</div>
          <h1 class="h-hero">I'm Aayush. I trade Nasdaq futures from India.</h1>
        </div>
        <div class="rest">
          <p class="lead"><span class="n">{paidShort}</span> paid out by prop firms so far. Every payout is shown below.</p>
          <p class="lead">On Instagram, I take prop firm accounts from evaluation to payout, step by step.</p>
          <div class="cta">
            <a class="btn white aboutbtn" href="/about" data-cta="home-hero">About me →</a>
            <a class="mail ui" href="#email-home">Or get the Sunday email ↓</a>
          </div>
        </div>
      </div>
      <div class="stack right">
        {portrait && (
          <div class="pframe" data-pframe>
            <div class="pback" aria-hidden="true"></div>
            <figure class="portrait">
              <Image src={portrait} alt="Aayush Namdev" widths={[168, 336, 300, 600]} sizes="(max-width: 860px) 168px, 300px" loading="eager" fetchpriority="high" />
            </figure>
            <p class="ui pname">Aayush Namdev</p>
          </div>
        )}
      </div>
    </div>
  </Band>

  <!-- 2. Proof. Total, count and date come from config/payouts.ts. -->
  <Band variant="wine">
    <div class="proofband" id="proof">
      <div class="stack proofcopy">
        <div class="label">The proof</div>
        <h2 class="h-sec">{apex2026Count} Apex payouts since June 2026.</h2>
        <p class="lead">Plus earlier payouts from Apex and Alpha Capital. <span class="n">{paidShort}</span> in total, as of {asOf}.</p>
        <p class="lead">Each one came from 20 to 30 minutes of trading a day. One trade, then I lock the account.</p>
        <p class="ui fine"><a href="/how-i-trade">How I trade, a preview →</a></p>
        <p class="ui fine">Most days are a small 1 to 1 and done. Big nights are rare. I show both.</p>
      </div>
      <div class="stack pilewrap">
        <ProofStack items={stackItems} />
        <p class="ui fine hint">Tap to flip through</p>
        <p class="ui fine"><a href="/about#payouts">See the full list →</a></p>
      </div>
    </div>
  </Band>

  <!-- 3. Latest journal post. Shows the newest post with a cover image. -->
  <Band>
    <LatestJournal />
  </Band>

  <!-- 4. Why follow -->
  <Band variant="white">
    <div class="stack why">
      <h2 class="h-sec">What you get by following</h2>
      <ul class="gets">
        <li><strong>Evaluation to payout.</strong> Watch accounts go from the test to the payout, on real trades.</li>
        <li><strong>The news, simply.</strong> Before NFP, CPI and the Fed, what is priced in and what could move NQ and gold.</li>
        <li><strong>ICT without the jargon.</strong> FVGs, liquidity and sessions, in plain words.</li>
      </ul>
      <div class="whybtn">
        <FollowButton size="large" cta="home-why" class="onwhite" />
        <a class="more ui" href="/start-here">New here? Read one real night, 7 min →</a>
      </div>
    </div>
  </Band>

  <!-- 5. Email. Coming soon teaser merged in. -->
  <Band variant="wine">
    <div class="stack soon" id="email-home">
      <div class="label">Coming soon</div>
      <h2 class="h-sec">My model, a preview.</h2>
      <p class="lead">The model behind about 95% of my trades. See how my day runs. The entry model comes next. Email subscribers get it first, plus the week ahead every Sunday.</p>
      <p class="ui sessions">Asia · London · New York, same model, every session</p>
      <EmailSignup variant="wine" id="email-home-input" source="home" prompt="" />
      <p class="ui fine"><a href="/how-i-trade">See the preview →</a></p>
    </div>
  </Band>

  {portraitClose && <StickyFollow thumb={portraitClose} />}
</BaseLayout>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 64px); align-items: start; margin-top: -48px; } /* band padding is 110px, the reference hero starts at 96px */
  .left { gap: 20px; }
  .left .lead { max-width: 560px; margin: 0; }
  .top, .rest { display: flex; flex-direction: column; gap: 20px; }
  .cta { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; margin-top: 4px; }
  .aboutbtn { min-height: 56px; padding: 12px 28px; font-size: 17px; font-weight: 600; }
  .mail { display: inline-flex; align-items: center; min-height: 44px; color: var(--rose-text); font-size: 15px; }
  .right { gap: 16px; padding-top: 30px; }
  /* Photo card: a matted frame with a second card behind it, tilted like the certificate stack. */
  .pframe { --rx: 2deg; --ry: -7deg; position: relative; width: 300px; max-width: 100%; margin: 0 auto; perspective: 900px; }
  .pback { position: absolute; inset: 0 0 34px; border-radius: var(--radius-card); background: var(--surface-raised); border: 1px solid var(--line); transform: rotate(5deg) translate(14px, 6px); z-index: 0; }
  .portrait {
    position: relative; z-index: 1; margin: 0; padding: 10px; background: var(--surface);
    border: 1px solid var(--line-strong); border-radius: var(--radius-card);
    border-right-color: var(--wine); border-bottom: 3px solid var(--wine);
    box-shadow: var(--shadow-pop);
    transform: rotateX(var(--rx)) rotateY(var(--ry)); transition: transform 0.3s ease-out;
  }
  .portrait :global(img) { display: block; width: 100%; height: auto; border-radius: 8px; }
  .pname { position: relative; z-index: 1; margin: 14px 0 0; text-align: center; font-family: var(--font-number); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
  @media (prefers-reduced-motion: reduce) { .portrait { transition: none; } }

  .proofband { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 500px); gap: clamp(32px, 5vw, 64px); align-items: center; scroll-margin-top: 40px; }
  .proofcopy { gap: 16px; }
  .proofcopy .lead { margin: 0; }
  .fine { font-size: 14px; color: var(--text-on-wine); margin: 0; }
  .fine a { color: var(--white); display: inline-flex; align-items: center; min-height: 44px; }
  .pilewrap { align-items: center; gap: 0; }
  .hint { text-align: center; }

  .why { gap: 28px; max-width: 680px; }
  .gets { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 18px; }
  .gets li { font-family: var(--font-body); font-size: 19px; line-height: 1.5; color: var(--ink-body); padding-left: 16px; border-left: 3px solid var(--wine); }
  .gets strong { font-family: var(--font-heading); font-weight: 600; color: var(--ink); }
  .whybtn { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .more { display: inline-flex; align-items: center; min-height: 44px; color: var(--wine); font-size: 15px; }
  .whybtn :global(.follow) { background: var(--wine); color: var(--white) !important; }
  .whybtn :global(.follow .handle) { color: var(--text-on-wine); }

  .soon { gap: 16px; max-width: 680px; }
  .soon .lead { margin: 0; }
  .sessions { font-family: var(--font-number); font-size: 13px; color: var(--text-on-wine); margin: 0; }

  @media (max-width: 860px) {
    :global(main .band.band.band) { padding: 40px 0; } /* the home page is about three phone screens, so tighter than other pages */
    /* Phone: the page starts with the full photo, then the headline, the two lines, then the About me button. */
    .hero { grid-template-columns: minmax(0, 1fr); grid-template-areas: "photo" "top" "rest"; gap: 12px; margin-top: -14px; }
    .left { display: contents; }
    .top { grid-area: top; gap: 10px; }
    .rest { grid-area: rest; gap: 14px; }
    .left :global(.h-hero) { font-size: 28px; }
    .left .lead { font-size: 17px; line-height: 1.5; }
    .right { grid-area: photo; justify-self: center; display: block; padding: 0; overflow: visible; }
    .pframe { width: 168px; --rx: 0deg; --ry: 0deg; perspective: none; }
    .pback, .pname { display: none; }
    .portrait { padding: 5px; transform: none; box-shadow: none; }
    .portrait :global(img) { border-radius: 6px; }
    .cta { align-items: stretch; }
    .mail { justify-content: center; }
    .proofband { grid-template-columns: 1fr; gap: 20px; }
    .proofcopy { gap: 12px; }
    .why { gap: 22px; }
    .sessions { display: none; } /* does not fit on one line at 375px, so the brief says drop it */
    .gets li { font-size: 18px; }
    .whybtn { align-items: stretch; }
    .more { justify-content: center; }
  }
</style>

<script>
  const pf = document.querySelector<HTMLElement>('[data-pframe]');
  if (pf && matchMedia('(hover: hover)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    pf.addEventListener('pointermove', (e) => {
      const r = pf.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width - 0.5;
      const py = (e.clientY - r.top) / r.height - 0.5;
      pf.style.setProperty('--rx', `${(2 - py * 10).toFixed(2)}deg`);
      pf.style.setProperty('--ry', `${(-7 + px * 14).toFixed(2)}deg`);
    });
    pf.addEventListener('pointerleave', () => { pf.style.setProperty('--rx', '2deg'); pf.style.setProperty('--ry', '-7deg'); });
  }
</script>
