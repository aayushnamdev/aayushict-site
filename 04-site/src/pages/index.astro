---
import BaseLayout from '../layouts/BaseLayout.astro';
import PathSteps from '../components/PathSteps.astro';
import PricedInMeter from '../components/PricedInMeter.astro';
import InlineFirmCTA from '../components/InlineFirmCTA.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';

const macroEntries = (await getCollection('macro')).sort(
  (a, b) => b.data.updated.valueOf() - a.data.updated.valueOf()
);
const latestBriefing = macroEntries[0];

const learnEntries = (await getCollection('learn')).sort((a, b) => a.data.order - b.data.order);
const journalEntries = (await getCollection('journal')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// "What's new": briefings and guides mixed, newest first, top 5.
const whatsNew = [
  ...macroEntries.map((m) => ({
    title: m.data.title,
    date: m.data.updated,
    category: m.data.event,
    href: `/macro/${m.data.slug}`,
  })),
  ...learnEntries.map((g) => ({
    title: g.data.title,
    date: g.data.updated,
    category: g.data.category,
    href: `/learn/${g.data.category}/${g.id}`,
  })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 5);
---

<BaseLayout title={`${site.name} · ${site.brandStatement}`} description={site.specificityLine}>
  <section class="hero">
    <div class="container measure">
      <h1>{site.brandStatement}</h1>
      <p class="specificity">{site.specificityLine}</p>
      <p class="promise">{site.promiseLine}</p>
      <div class="doors">
        <a href="/learn" class="btn btn-primary">New to macro? Start from zero</a>
        {latestBriefing && (
          <a href={`/macro/${latestBriefing.data.slug}`} class="btn btn-secondary">
            Already trading? This week's briefing
          </a>
        )}
      </div>
    </div>
  </section>

  {latestBriefing?.data.pricedIn && (
    <section class="container measure section">
      <h2>This week in macro</h2>
      <PricedInMeter label={latestBriefing.data.pricedIn.label} path={latestBriefing.data.pricedIn.path} />
      <p><a href={`/macro/${latestBriefing.data.slug}`}>Read the full briefing →</a></p>
    </section>
  )}

  <section class="container section">
    <h2>The path</h2>
    <PathSteps />
  </section>

  {whatsNew.length > 0 && (
    <section class="container measure section">
      <h2>What's new</h2>
      <ul class="whats-new-list">
        {whatsNew.map((item) => (
          <li>
            <span class="badge">{item.category}</span>
            <a href={item.href}>{item.title}</a>
            <span class="date mono">{item.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="container measure section">
    <h2>How one event plays out</h2>
    <p>September 2026. Non farm payrolls came in at 162K against 55K expected.</p>
    <p>Rate hike odds moved from 49% to 72% the same morning.</p>
    <p>CPI was next. Headline came in as expected. Core came in hot.</p>
    <p>Gold dropped toward my level. I had a target and an invalidation set before the number.</p>
    <InlineFirmCTA slug="fundednext" lead="To trade this without risking your own capital, here is the firm I use." />
    <p><a href="/journal">See the full call in the journal →</a></p>
  </section>

  {learnEntries.length > 0 && (
    <section class="container measure section">
      <h2>Popular guides</h2>
      <ul class="simple-list">
        {learnEntries.slice(0, 6).map((g) => (
          <li><a href={`/learn/${g.data.category}/${g.id}`}>{g.data.title}</a></li>
        ))}
      </ul>
    </section>
  )}

  {journalEntries.length > 0 && (
    <section class="container measure section">
      <h2>Journal</h2>
      <ul class="simple-list">
        {journalEntries.slice(0, 3).map((j) => (
          <li>
            <a href={`/journal/${j.id}`}>
              {j.data.title ?? `${j.data.asset} ${j.data.kind}`} · {j.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
            </a>
          </li>
        ))}
      </ul>
      <p><a href="/journal">See the full journal →</a></p>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    padding: 4rem 0 3rem;
  }
  .hero h1 {
    margin-bottom: 1rem;
  }
  .specificity {
    font-size: 1.2rem;
    color: var(--text-muted);
  }
  .promise {
    font-weight: 600;
  }
  .doors {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .section {
    padding: 2.5rem 0;
    border-top: 1px solid var(--border);
  }
  .whats-new-list,
  .simple-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .whats-new-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .whats-new-list .date {
    margin-left: auto;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
</style>
