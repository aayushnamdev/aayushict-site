---
import PostLayout from '../layouts/PostLayout.astro';
import Icon from '../components/Icon.astro';
import SessionsArc from '../components/SessionsArc.astro';
import DayRoutine from '../components/DayRoutine.astro';
import TradeGate from '../components/TradeGate.astro';
import EmailSignup from '../components/EmailSignup.astro';
import { site, person } from '../config/site';

// A preview, not the model. Shown: the order of my day, the skip rules, one trade a day. Sealed: the entry model,
// exits, stop, risk, what I do after a loss. Sealed parts get a locked card and one teaser line, nothing more.
// Brief and the shown/sealed line: 00-strategy/homepage-spec-2026-10.md. Draft copy: 03-content/drafts/model-preview.md
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'My model, a preview',
  url: `${site.url}/how-i-trade/`,
  inLanguage: 'en-IN',
  author: { '@id': person['@id'] },
};
const sealed = [
  { icon: 'chart', title: 'The entry model', line: 'The setup I look for on the 1 minute.' },
  { icon: 'target', title: 'Where I exit', line: 'How I decide I am done.' },
  { icon: 'pin', title: 'My stop', line: 'Where I am wrong, and how far.' },
  { icon: 'layers', title: 'How I size risk', line: 'How much I put on, and when that changes.' },
  { icon: 'clock', title: 'After a loss', line: 'What I do the next day.' },
] as const;
---
<PostLayout
  title="My model, a preview"
  subtitle="The model behind about 95% of my trades. Here is how my day runs."
  description="A preview of how I trade Nasdaq futures. My day in order, and the two checks that decide if I trade. The entry model comes next. Join the list to get it first."
  meta="Aayush Namdev · Preview"
  image="/og-how-i-trade-v3.jpg"
  imageAlt="How I trade. Coming soon. Aayush Namdev."
  jsonLd={jsonLd}
  signup={false}
  footerSignup={false}
>
  <p>All my payouts came from 20 to 30 minutes a day.</p>
  <p>Not hours of charting. Here is how my day runs.</p>

  <h2>My day</h2>
  <DayRoutine />

  <p>Two checks decide if I trade at all. Try them.</p>

  <h2>Would I trade today?</h2>
  <TradeGate />

  <p>The model works best when the market is moving. That is why I trade the New York morning mostly.</p>
  <p>But it repeats in every session. If London or Asia has good ranges, I trade them too.</p>

  <SessionsArc />

  <h2>Coming next</h2>
  <p>These parts stay locked for now. Email subscribers get them first.</p>
  <ul class="sealed">
    {sealed.map((s) => (
      <li>
        <span class="ic"><Icon name={s.icon} size={26} /></span>
        <div class="txt">
          <h3 class="ui">{s.title}</h3>
          <p>{s.line}</p>
          <span class="bars" aria-hidden="true"><i></i><i></i></span>
        </div>
        <span class="lock mono"><Icon name="lock" size={14} /> Soon</span>
      </li>
    ))}
  </ul>

  <div class="getit">
    <h2 class="ui">Get it first</h2>
    <p class="close">Preview, then more. The entry model comes next. Email gets it first.</p>
    <EmailSignup variant="band" id="email-teaser" source="how-i-trade" prompt="" />
  </div>
</PostLayout>

<style>
  .sealed { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .sealed li { position: relative; display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 14px; padding: 18px 16px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-card); }
  .ic { color: var(--rose-text); padding-top: 2px; }
  h3 { font-size: 18px; color: var(--text-heading); margin: 0 0 4px; }
  .txt p { font-size: 16px; line-height: 1.5; color: var(--text-soft); margin: 0; }
  .bars { display: flex; flex-direction: column; gap: 6px; margin-top: 12px; }
  .bars i { display: block; height: 8px; border-radius: 4px; background: var(--line-strong); filter: blur(2.5px); }
  .bars i:first-child { width: 88%; }
  .bars i:last-child { width: 56%; }
  .lock { position: absolute; top: 14px; right: 14px; display: inline-flex; align-items: center; gap: 5px; font-size: 12px; color: var(--text-muted); }
  .getit { background: var(--surface); border: 1px solid var(--line-strong); border-bottom: 3px solid var(--wine); border-radius: var(--radius-card); padding: 22px 20px; }
  .getit h2 { font-size: 22px; margin: 0 0 8px; }
  .close { font-size: 16px; line-height: 1.5; color: var(--text-soft); margin: 0 0 14px; }
  .sealed li:last-child:nth-child(odd) { grid-column: 1 / -1; }
  @media (max-width: 700px) { .sealed { grid-template-columns: 1fr; } }
</style>
