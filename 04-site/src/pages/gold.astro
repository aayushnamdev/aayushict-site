---
// Landing page for the gold bounce reel (21 Nov 2026). Link in bio points here.
// Signups are saved with metadata.source "gold-bounce". When they confirm, /api/buttondown-hook sends the checklist.
// Noindex (listed in site.pending): it is a reel page, not a page for search.
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorCard from '../components/AuthorCard.astro';
import EmailSignup from '../components/EmailSignup.astro';
import { telegram } from '../config/site';

const inside = [
  'Why gold fell on Friday, in 30 seconds.',
  'My chart, with the exact levels I am watching.',
  'Five boxes that tell me the panic is ending.',
  'Where my plan is wrong, so I step aside.',
];
---
<BaseLayout
  title="Gold bounce checklist"
  description="My gold bounce checklist, with the exact levels I am watching. Sign up and it lands in your email."
  showFooterSignup={false}
  narrow
>
  <div class="article col">
    <p class="label">From the reel</p>
    <h1 class="title">My gold bounce checklist</h1>
    <p class="sub">The exact levels I am watching. Free, straight to your email.</p>

    <EmailSignup
      id="gold-email"
      source="gold-bounce"
      prompt=""
      button="Send me the checklist"
      thanks="Almost there. Open your inbox and tap confirm. The checklist arrives right after."
    />
    <p class="steps">Two steps: sign up, then tap confirm in the email I send. Check spam or Promotions if you do not see it.</p>

    <h2>What is inside</h2>
    <ul class="inside">
      {inside.map((line) => <li>{line}</li>)}
    </ul>
    <p>Then before Wednesday's Core PCE, 7 PM India time, my next update comes to the same inbox.</p>
    <p>Want updates during the week too? <a href={telegram.href} rel="noopener" target="_blank">Join the {telegram.name} on Telegram</a>.</p>

    <div class="card"><AuthorCard /></div>
  </div>
</BaseLayout>

<style>
  .label { font-family: var(--font-number); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--rose-text); margin: 0 0 8px; }
  .sub { margin: 14px 0 24px; }
  p { font-size: var(--read-body); line-height: 1.7; color: var(--text-body); margin: 0 0 14px; }
  .steps { font-size: 15px; color: var(--text-soft); margin-top: 12px; }
  h2 { margin: 36px 0 12px; }
  .inside { margin: 0 0 18px; padding-left: 1.2em; }
  .inside li { font-size: var(--read-body); line-height: 1.7; color: var(--text-body); margin-bottom: 6px; }
  .card { margin: 32px 0 8px; }
</style>
