---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { published, formatDate } from '../../lib/content';
import { articleLd } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await published('macro');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
---
<PostLayout
  title={d.title}
  subtitle={d.subtitle}
  route={d.route}
  meta={`Aayush Namdev · ${formatDate(d.date)} · ${d.readMinutes} min read`}
  type="article"
  jsonLd={articleLd({ title: d.title, description: d.subtitle, path: `/macro/${post.id}/`, published: d.date })}
>
  <Content />
</PostLayout>
