---
import PostLayout from '../layouts/PostLayout.astro';
import StatChips from '../components/StatChips.astro';
import ProofGrid from '../components/ProofGrid.astro';
import MoreBox from '../components/MoreBox.astro';
import PayoutTable from '../components/PayoutTable.astro';
import { site, person, social } from '../config/site';
import { paidShort, asOf } from '../config/payouts';
import apex1446 from '../assets/proof/apex-payout-2026-08-12.png';
import apex1366 from '../assets/proof/apex-1366-payout-2026-09-02.png';
import apex596 from '../assets/proof/apex-596-payout-2026-08-26.png';
import alpha3006 from '../assets/proof/alpha-capital-lifetime-2025-02-14.png';

// Copy follows Aayush's own notes (4 Oct 2026): a real trader, payouts as proof not a brag,
// macro for direction, the model on the 1 minute chart, no jargon, affiliate links only.
// Lines are not yet reviewed by him, so they are listed in 03-content/front-page/placeholders.md.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Aayush Namdev',
  url: `${site.url}/about/`,
  inLanguage: 'en-IN',
  mainEntity: {
    ...person,
    jobTitle: 'Funded Nasdaq futures trader',
    description:
      'Trades Nasdaq futures on funded accounts. Scalps on the 1 minute chart in the New York morning session and uses macro news for direction. Writes about what is priced in, without the jargon.',
    knowsAbout: ['Nasdaq futures', 'Macroeconomics', 'Scalping', 'Prop firm trading', 'ICT'],
  },
};
---
<PostLayout
  title="About"
  subtitle="A real trader, explaining macro in plain words."
  meta={`Aayush Namdev · Updated ${asOf} · 3 min read`}
  type="website"
  jsonLd={jsonLd}
>
  <!-- PLACEHOLDER: all copy below is drafted from Aayush's notes, not yet read and edited by him -->
  <p>I'm Aayush. I trade Nasdaq futures every day.</p>
  <p>I scalp on the 1 minute chart, mostly in the New York morning session. I have an MA in Psychology and six years in markets.</p>
  <p>I trade funded accounts. Most of my payouts came from Apex Trader Funding. Some came from Alpha Capital.</p>
  <p>These are my payouts so far. I show them for one reason. You should know a real trader is writing this.</p>

  <StatChips chips={[`${paidShort} paid out`, 'Apex and Alpha Capital', `As of ${asOf}`]} />

  <ProofGrid
    items={[
      { id: 'proof-apex-1446', src: apex1446, alt: 'Apex Trader Funding rewards certificate for Aayush Namdev, $1,446, approved 12 August 2026', caption: 'Apex, $1,446, approved 12 Aug 2026' },
      { id: 'proof-apex-1366', src: apex1366, alt: 'Apex Trader Funding rewards certificate for Aayush Namdev, $1,366, approved 2 September 2026', caption: 'Apex, $1,366, approved 2 Sep 2026' },
      { id: 'proof-apex-596', src: apex596, alt: 'Apex Trader Funding rewards certificate for Aayush Namdev, $596, approved 26 August 2026', caption: 'Apex, $596, approved 26 Aug 2026' },
      { id: 'proof-alpha-3006', src: alpha3006, alt: 'Alpha Capital lifetime payouts certificate for Aayush Namdev, $3,006, dated 14 February 2025', caption: 'Alpha Capital, $3,006 lifetime, 14 Feb 2025' },
    ]}
  />

  <MoreBox title="See every payout">
    <PayoutTable />
  </MoreBox>

  <h2>How I trade</h2>
  <p>I start with the macro. News like NFP, CPI and the Fed gives me direction and conviction.</p>
  <p>Then the model takes over. It finds my entry on the 1 minute chart.</p>
  <p>The news tells me which way. The model tells me where to get in.</p>

  <h2>What this site is for</h2>
  <p>Wall Street hides behind jargon. Open any CNBC or Bloomberg article and you will see it.</p>
  <p>A normal person cannot follow that. So I strip down every jargon. I focus on the raw thing, and how it is impacting the markets.</p>
  <p>I do not sell mentorship. I do not sell courses or signals. The only money here comes from affiliate links. Each one is marked where it appears. You can read the <a href="/disclosure">disclosure</a>.</p>

  <p>You can find me here.</p>
  <ul class="handles">
    {social.map((s) => (
      <li><a href={s.href} rel="me noopener" target="_blank"><span class="where">{s.label}</span><span class="who">{s.handle}</span></a></li>
    ))}
  </ul>
</PostLayout>

<style>
  .handles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .handles a { display: flex; flex-direction: column; justify-content: center; min-height: 64px; padding: 10px 16px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-card); text-decoration: none; transition: border-color 0.2s; }
  .handles a:hover { border-color: var(--wine); }
  .where { font-family: var(--font-number); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--rose-text); }
  .who { font-family: var(--font-ui); font-size: 16px; color: var(--text-heading); }
  @media (max-width: 860px) { .handles { grid-template-columns: 1fr; } }
</style>
