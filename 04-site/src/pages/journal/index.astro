---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { published, formatDate } from '../../lib/content';

const entries = (await published('journal')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const kindLabel = { call: 'Call', 'trading-day': 'Trading day', story: 'Story' } as const;
---
<BaseLayout
  title="Journal"
  description="My own story and the trades I took, in my own words. Wins and losses both."
  narrow
>
  <div class="article col">
    <h1 class="title">Journal</h1>
    <p class="sub">My own story and the trades I took, in my own words.</p>
    <a class="soon" href="/how-i-trade">
      <span class="kind label">Coming soon</span>
      <span class="name ui">How I trade, every day</span>
      <span class="desc">The model behind about 95% of my trades. Join the list to get it first.</span>
    </a>
    {entries.length === 0 ? (
      <p class="empty">First entry coming soon.</p>
    ) : (
      <ul class="list">
        {entries.map((e) => (
          <li>
            <a href={`/journal/${e.id}`}>
              <span class="kind label">{kindLabel[e.data.kind]}</span>
              <span class="name ui">{e.data.title}</span>
              {e.data.description && <span class="desc">{e.data.description}</span>}
              <time class="when ui" datetime={e.data.date.toISOString()}>{formatDate(e.data.date)}</time>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>

<style>
  .list { list-style: none; margin: 40px 0 0; padding: 0; display: grid; gap: 14px; }
  .list a {
    display: grid; gap: 6px; padding: 20px 22px; text-decoration: none; color: inherit;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-card);
  }
  @media (hover: hover) { .list a:hover { border-color: var(--wine); } }
  .name { font-size: 22px; line-height: 1.3; color: var(--text-heading); font-weight: 600; }
  .desc { font-size: 17px; line-height: 1.55; color: var(--text-soft); }
  .when { font-size: 14px; color: var(--text-muted); }
  .soon { display: grid; gap: 6px; margin-top: 32px; padding: 20px 22px; text-decoration: none; color: inherit; background: var(--surface); border: 1px dashed var(--rose); border-radius: var(--radius-card); }
  @media (hover: hover) { .soon:hover { border-color: var(--wine); } }
  .empty { margin-top: 40px; color: var(--text-soft); }
</style>
