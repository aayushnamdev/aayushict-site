---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { published, minutesToRead } from '../../lib/content';
import { articleLd } from '../../lib/seo';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const entries = await published('journal');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const minutes = d.readMinutes ?? minutesToRead(entry.body);
const description = d.description ?? site.tagline;
---
<PostLayout
  title={d.title}
  description={description}
  article={{ date: d.date, minutes }}
  headings={headings}
  current={`journal/${entry.id}`}
  progress
  signOff={d.kind !== 'story'}
  type="article"
  jsonLd={articleLd({ title: d.title, description, path: `/journal/${entry.id}/`, published: d.date })}
>
  <Content />
</PostLayout>
