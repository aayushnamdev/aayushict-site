---
// "Keep reading": up to two other articles (guides and Journal posts), newest first. Hidden if there is nothing else.
import { published, formatDate } from '../lib/content';
interface Props { current: string } // "learn/prop-firms/slug" or "journal/slug", the page being read
const { current } = Astro.props;
const [guides, entries] = await Promise.all([published('learn'), published('journal')]);
const all = [
  ...guides.map((g) => ({ key: `learn/${g.id}`, kind: 'Guide', title: g.data.title, desc: g.data.subtitle, href: `/learn/${g.id}`, date: g.data.updated })),
  ...entries.map((e) => ({ key: `journal/${e.id}`, kind: 'Journal', title: e.data.title, desc: e.data.description ?? '', href: `/journal/${e.id}`, date: e.data.date })),
].filter((x) => x.key !== current).sort((a, b) => b.date.valueOf() - a.date.valueOf()).slice(0, 2);
---
{all.length > 0 && (
  <section class="rel" aria-labelledby="rel-h">
    <h2 id="rel-h" class="ui">Keep reading</h2>
    <ul>
      {all.map((x) => (
        <li>
          <a href={x.href}>
            <span class="k mono">{x.kind} · {formatDate(x.date)}</span>
            <span class="t ui">{x.title}</span>
            {x.desc && <span class="d">{x.desc}</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .rel { margin-top: 56px; }
  h2 { font-size: 22px; color: var(--text-heading); margin: 0 0 16px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  a { display: grid; gap: 6px; height: 100%; padding: 18px 20px; text-decoration: none; color: inherit; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-card); }
  @media (hover: hover) { a:hover { border-color: var(--wine); } }
  .k { font-size: 12.5px; color: var(--rose-text); }
  .t { font-size: 19px; line-height: 1.3; font-weight: 600; color: var(--text-heading); }
  .d { font-size: 15.5px; line-height: 1.5; color: var(--text-soft); }
  @media (max-width: 700px) { ul { grid-template-columns: 1fr; } }
</style>
