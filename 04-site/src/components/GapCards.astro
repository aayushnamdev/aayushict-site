---
// Four cards. The last one is wine ("Here"). Lives inside a white band, so cards use the tint.
interface Card { title: string; text: string; highlight?: boolean }
interface Props { cards: Card[] }
const { cards } = Astro.props;
---
<div class="g4">
  {cards.map((c) => (
    <div class:list={['card', { hl: c.highlight }]}>
      <h3>{c.title}</h3>
      <p>{c.text}</p>
    </div>
  ))}
</div>

<style>
  .g4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .card { background: var(--white-tint); border: 1px solid var(--white-line); border-radius: var(--radius-card); padding: 24px; }
  .card h3 { font-size: 22px; margin-bottom: 8px; }
  .card p { font-size: 17px; line-height: 1.6; color: var(--ink-muted); }
  .hl { background: var(--wine); border-color: var(--wine); }
  .hl h3 { color: var(--white); }
  .hl p { color: var(--text-on-wine); }
  @media (max-width: 1100px) { .g4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 599px) { .g4 { grid-template-columns: 1fr; } }
</style>
