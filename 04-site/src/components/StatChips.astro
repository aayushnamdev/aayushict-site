---
// Mono chips for numbers. Static, not interactive.
interface Props { chips: string[] }
const { chips } = Astro.props;
---
<div class="chips">{chips.map((c) => <span class="chip">{c}</span>)}</div>

<style>
  .chips { display: flex; gap: 10px; flex-wrap: wrap; }
  .chip { font-family: var(--font-number); font-size: 14px; line-height: 1.3; padding: 9px 14px; border-radius: var(--radius-button); background: var(--surface); border: 1px solid var(--line); color: var(--text-heading); }
</style>
