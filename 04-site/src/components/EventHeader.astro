---
interface Props {
  event: string;
  releaseAt: Date;
  badge: 'Preview' | 'Post release' | 'Review';
  updated: Date;
}
const { event, releaseAt, badge, updated } = Astro.props;

const fmt = (tz: string) =>
  new Intl.DateTimeFormat('en-US', {
    timeZone: tz,
    month: 'short',
    day: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
    hour12: true,
  }).format(releaseAt);

const et = fmt('America/New_York');
const ist = fmt('Asia/Kolkata');
const updatedStr = updated.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const badgeClass =
  badge === 'Preview' ? 'badge-preview' : badge === 'Post release' ? 'badge-post' : 'badge-review';
---

<div class="event-header">
  <div class="event-header-top">
    <h1>{event}</h1>
    <span class={`badge ${badgeClass}`}>{badge}</span>
  </div>
  <p class="event-times">
    Release: <span class="mono">{ist} IST</span> / <span class="mono">{et} ET</span>
  </p>
  <p class="event-updated">Updated {updatedStr}</p>
</div>

<style>
  .event-header {
    margin-bottom: 1.5rem;
  }
  .event-header-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .event-header-top h1 {
    margin: 0;
  }
  .badge-preview { background: #EAF0FF; color: var(--accent); border-color: #C9D9FF; }
  .badge-post { background: #FFF3DE; color: var(--cta); border-color: #F0DCA6; }
  .badge-review { background: var(--surface-muted); color: var(--text-muted); }
  .event-times {
    margin: 0.5rem 0 0.25rem;
    color: var(--text-muted);
  }
  .event-updated {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>
