---
// Dotted rose underline. Tap opens a short box. Slot = the word, `title` = box heading, `text` = box body.
interface Props { title: string; text: string }
const { title, text } = Astro.props;
---
<button class="tip" type="button" aria-expanded="false" data-tip><slot /><span class="tipbox" role="note"><b>{title}</b>{text}</span></button>

<script>
  const tips = () => document.querySelectorAll<HTMLButtonElement>('[data-tip]');
  const close = (except?: Element) => tips().forEach((t) => { if (t !== except) { t.classList.remove('open'); t.setAttribute('aria-expanded', 'false'); } });
  document.addEventListener('click', (e) => {
    const tip = (e.target as Element).closest<HTMLButtonElement>('[data-tip]');
    close(tip ?? undefined);
    if (!tip) return;
    const open = tip.classList.toggle('open');
    tip.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
</script>

<style>
  .tip {
    position: relative; padding: 0; font: inherit; color: var(--text-heading); background: none; cursor: pointer;
    border: none; border-bottom: 2px dotted var(--rose);
  }
  /* Invisible padding so the tap area reaches 44px while the text stays inline. */
  .tip::after { content: ''; position: absolute; inset: -9px -6px; }
  .tipbox {
    display: none; position: absolute; left: 0; top: calc(100% + 10px); z-index: 10; width: 300px; max-width: calc(100vw - 2 * var(--phone-padding));
    background: var(--surface); border: 1px solid var(--line-strong); border-radius: 12px; padding: 14px 16px;
    text-align: left; font-family: var(--font-body); font-weight: 400; font-size: 16px; line-height: 1.55; letter-spacing: 0;
    color: var(--text-body); box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
  }
  .tipbox b { display: block; font-family: var(--font-ui); font-size: 13px; color: var(--rose); margin-bottom: 4px; }
  .tip.open .tipbox { display: block; }
</style>
