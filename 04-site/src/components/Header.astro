---
import { site } from '../config/site';
import Wordmark from './Wordmark.astro';
interface Props { narrow?: boolean }
const { narrow = false } = Astro.props;
const path = Astro.url.pathname;
const isOn = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="top">
  <div class:list={['wrap', 'bar', { narrow }]}>
    <a class="logo" href="/" aria-label="aayushict home"><Wordmark /></a>
    <nav class="nav" aria-label="Main">
      {site.nav.map((l) => <a href={l.href} class:list={[{ on: isOn(l.href) }]} aria-current={isOn(l.href) ? 'page' : undefined}>{l.label}</a>)}
      <a class="btn" href={site.cta.href} aria-current={isOn(site.cta.href) ? 'page' : undefined}>{site.cta.label}</a>
    </nav>
    <div class="right">
      <a class="btn sm" href={site.cta.href} aria-current={isOn(site.cta.href) ? 'page' : undefined}>{site.cta.label}</a>
      <button class="menu" id="menuBtn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="drawer"><span></span><span></span><span></span></button>
    </div>
  </div>
  <nav class="drawer" id="drawer" aria-label="Mobile">
    {site.nav.map((l) => <a href={l.href} aria-current={isOn(l.href) ? 'page' : undefined}>{l.label}</a>)}
  </nav>
</header>

<script>
  const btn = document.getElementById('menuBtn');
  const drawer = document.getElementById('drawer');
  const setOpen = (open: boolean) => {
    drawer?.classList.toggle('open', open);
    btn?.setAttribute('aria-expanded', String(open));
  };
  btn?.addEventListener('click', () => setOpen(!drawer?.classList.contains('open')));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer?.classList.contains('open')) { setOpen(false); (btn as HTMLElement | null)?.focus(); }
  });
  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    if (drawer?.classList.contains('open') && !drawer.contains(t) && !btn?.contains(t)) setOpen(false);
  });
  window.matchMedia('(min-width: 861px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
</script>

<style>
  .top {
    position: sticky; top: 0; z-index: 20;
    background: var(--header-bg); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
    padding-top: env(safe-area-inset-top, 0px);
  }
  /* Reading pages: same box as .article so the logo and the text share a left edge. */
  @media (min-width: 861px) { .bar.narrow { max-width: calc(var(--read-width) + 48px); padding: 0 24px; } }
  .bar { display: flex; justify-content: space-between; align-items: center; height: 68px; }
  .logo { text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  .nav { display: flex; align-items: center; gap: 30px; font-family: var(--font-ui); font-size: 15px; }
  .nav a { color: var(--text-body); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; padding: 0; border-bottom: 2px solid transparent; }
  @media (hover: hover) { .nav a:hover { color: var(--text-heading); } }
  .nav a.on { color: var(--text-heading); border-bottom-color: var(--wine); }
  .nav a.btn { padding: 12px 18px; border-bottom: none; color: var(--white); }
  .right, .drawer { display: none; }
  .menu {
    display: none; width: 44px; height: 44px; background: none; border: none;
    flex-direction: column; justify-content: center; align-items: center; gap: 5px;
  }
  .menu span { width: 22px; height: 2px; background: var(--text-body); transition: transform 0.15s, opacity 0.15s; }
  .menu[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .menu[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 860px) {
    .bar { height: 64px; }
    .nav { display: none; }
    .menu { display: flex; }
    .right { display: flex; align-items: center; gap: 10px; }
    .drawer.open {
      display: flex; flex-direction: column; gap: 4px;
      padding: 8px var(--phone-padding) 20px; border-top: 1px solid var(--line);
    }
    .drawer a {
      font-family: var(--font-ui); font-size: 17px; color: var(--text-body);
      text-decoration: none; padding: 12px 0; border-bottom: 1px solid var(--line);
    }
    .drawer a.btn { margin-top: 12px; border: none; color: var(--white); justify-content: center; }
  }
</style>
