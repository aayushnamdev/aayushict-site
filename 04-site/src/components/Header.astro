---
import { site, nav, startHereCta } from '../data/site';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">{site.name}</a>
    <nav class="main-nav">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <a href={startHereCta.href} class="btn btn-cta start-here-btn">{startHereCta.label}</a>
    <button class="menu-toggle" aria-label="Menu" aria-expanded="false">☰</button>
  </div>
  <nav class="mobile-nav" hidden>
    <ul>
      {nav.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
      <li><a href={startHereCta.href}>{startHereCta.label}</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
  }

  .logo {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text);
    text-decoration: none;
    margin-right: auto;
  }

  .main-nav ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .main-nav a {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }

  .main-nav a:hover {
    color: var(--accent);
  }

  .start-here-btn {
    font-size: 0.9rem;
    padding: 0.5rem 1rem;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    font-size: 1.4rem;
    cursor: pointer;
    color: var(--text);
  }

  .mobile-nav {
    border-top: 1px solid var(--border);
    padding: 0.5rem 1.25rem 1rem;
  }

  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mobile-nav a {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
  }

  @media (max-width: 720px) {
    .main-nav {
      display: none;
    }
    .start-here-btn {
      display: none;
    }
    .menu-toggle {
      display: block;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const mobileNav = document.querySelector('.mobile-nav');
  toggle?.addEventListener('click', () => {
    const isHidden = mobileNav?.hasAttribute('hidden');
    if (isHidden) {
      mobileNav?.removeAttribute('hidden');
      toggle.setAttribute('aria-expanded', 'true');
    } else {
      mobileNav?.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
    }
  });
</script>
