---
// Three variants: band (on black), wine (on the wine band), footer.
// Posts to our /api/subscribe route, which adds them to Buttondown (see config/email.ts). Works without JavaScript: the form has a real action.
// With JavaScript it sends the signup in the background and shows the result in place.
// If action is ever null, the form is not rendered at all, so nothing fake is shown.
import { email } from '../config/email';
interface Props {
  variant?: 'band' | 'wine' | 'footer';
  id: string; // unique per page, used to link label and input
  prompt?: string; // overrides the default line above the form
  source?: string; // which page the signup came from, saved as a tag in Buttondown
}
const { variant = 'band', id, prompt, source = 'website' } = Astro.props;
const text = prompt ?? (variant === 'footer' ? email.footerPrompt : email.prompt);
---
{email.action && (
  <div class:list={['signup', variant]}>
    {text && <p class="ui prompt">{text}</p>}
    <form
      class:list={['sform', { onwine: variant === 'wine' }]}
      data-signup
      action={email.action}
      method="post"
      data-thanks={email.thanks}
      data-error={email.error}
    >
      <label class="sr" for={id}>Email</label>
      <input id={id} name="email" type="email" inputmode="email" placeholder="you@email.com" required autocomplete="email" />
      <input type="hidden" name="embed" value="1" />
      <input type="hidden" name="source" value={source} />
      <!-- Honeypot: people never see or fill this. Bots often do. -->
      <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button class:list={['btn', { white: variant === 'wine' }]} type="submit">Sign me up</button>
    </form>
    <p class="ui fine">{email.fine}</p>
  </div>
)}

<script>
  import { trackSignup } from '../lib/track';
  const live = () => document.getElementById('live');
  // Without JavaScript the route redirects back with ?subscribed=1 or 0. Show the result in the first form.
  const flag = new URLSearchParams(location.search).get('subscribed');
  const first = document.querySelector<HTMLFormElement>('form[data-signup]');
  if (flag && first) {
    const msg = document.createElement('p');
    msg.className = 'ui thanks';
    msg.textContent = flag === '1' ? (first.dataset.thanks ?? '') : (first.dataset.error ?? '');
    first.after(msg);
    if (flag === '1') first.remove();
    const region = live();
    if (region) region.textContent = msg.textContent;
  }
  document.querySelectorAll<HTMLFormElement>('form[data-signup]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const done = (message: string, ok: boolean) => {
        const msg = document.createElement('p');
        msg.className = 'ui thanks';
        msg.tabIndex = -1;
        msg.textContent = message;
        if (ok) { form.replaceWith(msg); msg.focus(); }
        else { form.after(msg); setTimeout(() => msg.remove(), 6000); }
        const region = live();
        if (region) { region.textContent = ''; setTimeout(() => { region.textContent = message; }, 50); }
      };
      // A filled honeypot means a bot. Pretend it worked and send nothing.
      if ((form.elements.namedItem('website') as HTMLInputElement).value) return done(form.dataset.thanks ?? '', true);
      const label = button.textContent;
      button.disabled = true;
      button.textContent = 'Signing up...';
      try {
        const data = new FormData(form);
        data.delete('website');
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        trackSignup(String(data.get('source') ?? 'website'));
        done(form.dataset.thanks ?? '', true);
      } catch {
        button.disabled = false;
        button.textContent = label;
        done(form.dataset.error ?? '', false);
      }
    });
  });
</script>

<style>
  .signup { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 24px; }
  .prompt { font-size: 15px; color: var(--text-soft); margin: 0; }
  .band .prompt { font-size: 18px; }
  .wine .prompt { color: var(--text-on-wine); font-size: 18px; }
  .sform { display: flex; gap: 10px; flex: 1; min-width: 280px; max-width: 460px; }
  .sform input {
    flex: 1; min-width: 0; min-height: 48px; padding: 0 14px;
    border-radius: var(--radius-button); border: 1px solid var(--text-muted);
    background: var(--page); color: var(--text-heading);
    font-family: var(--font-ui); font-size: 16px;
  }
  .sform input::placeholder { color: var(--text-muted); }
  .sform.onwine input { background: var(--white); color: var(--ink); border-color: var(--white); }
  .sform.onwine input::placeholder { color: var(--ink-muted); }
  .sform :global(.btn) { min-height: 48px; white-space: nowrap; }
  .fine { flex-basis: 100%; margin: -6px 0 0; font-size: 13px; color: var(--text-muted); }
  .wine .fine { color: var(--text-on-wine); }
  .thanks { color: var(--text-heading); margin: 0; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  /* Phone: prompt, then the form, then the small line, all full width and lined up on the left.
     flex: none matters. The form's flex: 1 has a basis of 0, which beats width: 100% and squeezes it beside the prompt. */
  @media (max-width: 860px) {
    .signup { flex-direction: column; align-items: stretch; gap: 12px; }
    .sform { flex: none; flex-direction: column; min-width: 0; max-width: none; width: 100%; }
    .fine { margin: 0; }
  }
</style>
