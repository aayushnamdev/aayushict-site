---
interface Props {
  category?: string;
  updated?: Date;
  readTime?: number;
}
const { category, updated, readTime } = Astro.props;
const formatted = updated
  ? updated.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : null;
---

<p class="meta-row">
  {category && <span class="badge">{category}</span>}
  {formatted && <span>Updated {formatted}</span>}
  {readTime && <span>{readTime} min read</span>}
</p>

<style>
  .meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0 0 1.5rem;
  }
</style>
