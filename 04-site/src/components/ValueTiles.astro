---
// Full-tile links in a white band. Four tiles is the right number: more reads as a menu, not a choice.
// Each tile has the same shape: icon top left, arrow top right, then title and one line. So the arrows always line up.
import Icon from './Icon.astro';
interface Tile { title: string; text: string; href: string; icon?: 'flag' | 'book' | 'pencil' | 'screen' | 'mail' | 'camera' }
interface Props { tiles: Tile[] }
const { tiles } = Astro.props;
---
<div class="tiles">
  {tiles.map((t) => (
    <a class="tile" href={t.href} {...(t.href.startsWith('http') ? { target: '_blank', rel: 'me noopener' } : {})}>
      <span class="top">
        <span class="ic">{t.icon && <Icon name={t.icon} />}</span>
        <span class="arrow" aria-hidden="true">→</span>
      </span>
      <h3>{t.title}</h3>
      <p>{t.text}</p>
    </a>
  ))}
</div>

<style>
  .tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .tile { display: flex; flex-direction: column; background: var(--white-tint); border: 1px solid var(--white-line); border-radius: var(--radius-card); padding: 24px; text-decoration: none; color: inherit; transition: border-color 0.2s; }
  @media (hover: hover) { .tile:hover { border-color: var(--wine); color: inherit; } }
  .top { display: flex; align-items: center; justify-content: space-between; min-height: 30px; margin-bottom: 14px; }
  .ic { display: block; color: var(--wine); }
  .arrow { font-family: var(--font-ui); font-size: 22px; line-height: 1; color: var(--wine); }
  h3 { font-size: 22px; margin: 0 0 8px; }
  p { font-size: 17px; line-height: 1.6; color: var(--ink-muted); margin: 0; }
  @media (max-width: 1100px) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 599px) { .tiles { grid-template-columns: 1fr; gap: 12px; } .tile { padding: 20px; } }
</style>
