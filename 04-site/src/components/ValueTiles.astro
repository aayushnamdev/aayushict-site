---
// Four full-tile links. Sits inside a white band.
interface Tile { title: string; text: string; href: string }
interface Props { tiles: Tile[] }
const { tiles } = Astro.props;
---
<div class="tiles">
  {tiles.map((t) => (
    <a class="tile" href={t.href} {...(t.href.startsWith('http') ? { target: '_blank', rel: 'me noopener' } : {})}>
      <h3>{t.title} <span aria-hidden="true">→</span></h3>
      <p>{t.text}</p>
    </a>
  ))}
</div>

<style>
  .tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .tile { display: block; background: var(--white-tint); border: 1px solid var(--white-line); border-radius: var(--radius-card); padding: 24px; text-decoration: none; color: inherit; transition: border-color 0.2s; }
  .tile:hover { border-color: var(--wine); color: inherit; }
  h3 { font-size: 22px; margin-bottom: 8px; }
  h3 span { color: var(--wine); }
  p { font-size: 17px; line-height: 1.6; color: var(--ink-muted); }
  @media (max-width: 1100px) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 860px) { .tiles { grid-template-columns: 1fr; } }
</style>
