---
// White card with three numbered full-row links: where to go, in what order.
// Sits inside the wine band, so two band rules are overridden below (label colour, focus ring).
interface Step { title: string; text: string; href: string }
interface Props { label: string; steps: Step[] }
const { label, steps } = Astro.props;
---
<div class="card">
  <div class="label">{label}</div>
  <ol aria-label={label}>
    {steps.map((s, i) => (
      <li>
        <a class="step" href={s.href}>
          <span class="num mono" aria-hidden="true">{i + 1}</span>
          <span class="copy">
            <span class="title">{s.title}</span>
            <span class="text">{s.text}</span>
          </span>
          <span class="go" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ol>
</div>

<style>
  .card { background: var(--white); border-radius: var(--radius-white-card); padding: 28px 32px 12px; color: var(--ink-body); }
  /* Band.astro colours every label in a wine band pink. This one sits on white, so be more specific. */
  .card > .label { color: var(--wine); margin-bottom: 8px; }
  ol { list-style: none; margin: 0; padding: 0; }
  li + li { border-top: 1px solid var(--white-divider); }
  .step { display: grid; grid-template-columns: 36px minmax(0, 1fr) auto; gap: 16px; align-items: center; min-height: 44px; padding: 18px 8px; margin: 0 -8px; text-decoration: none; color: inherit; border-radius: 12px; transition: background 0.15s; }
  .step:hover { background: var(--white-tint); color: inherit; }
  .num { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--wine); color: var(--white); font-size: 15px; }
  .copy { display: flex; flex-direction: column; gap: 2px; }
  .title { font-family: var(--font-heading); font-weight: 600; font-size: 20px; line-height: 1.3; color: var(--ink); }
  .text { font-size: 16px; line-height: 1.5; color: var(--ink-muted); }
  .go { font-family: var(--font-ui); font-size: 20px; color: var(--wine); }
  /* Band.astro sets a white focus ring inside wine bands. White on this white card would vanish. */
  .card .step:focus-visible { outline-color: var(--wine); }
  @media (max-width: 860px) { .card { padding: 22px 18px 8px; border-radius: 18px; } .title { font-size: 18px; } .text { font-size: 15px; } }
</style>
