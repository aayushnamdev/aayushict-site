---
// Mono chips. Static ones are spans. One can open the proof in a dialog (wine border = opens proof).
import { Image } from 'astro:assets';
interface Chip { text: string; proof?: boolean }
interface Props {
  chips: Chip[];
  proofTitle: string;
  proofNote: string;
  proofImage: ImageMetadata;
  proofAlt: string;
}
const { chips, proofTitle, proofNote, proofImage, proofAlt } = Astro.props;
---
<div class="chips">
  {chips.map((c) => c.proof
    ? <button class="chip proof" type="button" data-open-proof>{c.text} ↗</button>
    : <span class="chip">{c.text}</span>)}
</div>

<dialog id="proof" aria-labelledby="proof-title">
  <div class="box">
    <h2 id="proof-title">{proofTitle}</h2>
    <p>{proofNote}</p>
    <Image src={proofImage} alt={proofAlt} widths={[520, 1040]} sizes="(max-width: 600px) 90vw, 520px" />
    <button class="btn" type="button" data-close-proof>Close</button>
  </div>
</dialog>

<script>
  const dlg = document.getElementById('proof') as HTMLDialogElement | null;
  document.querySelector('[data-open-proof]')?.addEventListener('click', () => dlg?.showModal());
  document.querySelector('[data-close-proof]')?.addEventListener('click', () => dlg?.close());
  // Click on the dark backdrop closes it too.
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>

<style>
  .chips { display: flex; gap: 10px; flex-wrap: wrap; }
  .chip {
    font-family: var(--font-number); font-size: 14px; line-height: 1.3; padding: 9px 14px;
    border-radius: var(--radius-button); background: var(--surface); border: 1px solid var(--line); color: var(--text-heading);
  }
  .proof { border-color: var(--rose); min-height: 44px; cursor: pointer; }
  dialog { border: 1px solid var(--line-strong); border-radius: 18px; padding: 0; background: var(--surface); color: var(--text-body); max-width: 560px; width: calc(100% - 2 * var(--phone-padding)); }
  dialog::backdrop { background: var(--overlay); }
  .box { padding: 28px; display: flex; flex-direction: column; gap: 14px; }
  h2 { font-size: 24px; line-height: 1.25; }
  p { font-size: 17px; line-height: 1.65; color: var(--text-soft); }
  .box :global(img) { border-radius: 10px; width: 100%; height: auto; }
  .box .btn { align-self: flex-start; margin-top: 6px; }
</style>
