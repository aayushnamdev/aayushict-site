---
// The two traders from the guide, side by side. Only what the guide says about each of them.
// Same fee, same rules, same platform. The paths are drawn, not real trades.
const cards = [
  { name: 'The scalper', points: '4,42 24,36 44,40 64,30 84,36 104,26 124,32 144,22', lines: ['Books in points.', 'Never lets a position float far from entry.'], fit: 'Fits intraday trailing' },
  { name: 'The runner', points: '4,56 34,52 58,28 78,40 104,14 126,26 144,8', lines: ['Three trades a week at 1 to 3 risk to reward.', 'Sits through drawdown inside the trade.'], fit: 'Fits end of day' },
];
---
<figure class="two">
  <div class="cards">
    {cards.map((c) => (
      <div class="card">
        <p class="ui nm">{c.name}</p>
        <svg viewBox="0 0 148 64" aria-hidden="true"><polyline points={c.points} /></svg>
        <ul>{c.lines.map((l) => <li>{l}</li>)}</ul>
        <p class="mono fit">◆ {c.fit}</p>
      </div>
    ))}
  </div>
  <figcaption class="cap ui">Same fee, same rules, same platform. One model matches how each makes money.</figcaption>
</figure>

<style>
  .two { margin: 0; }
  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-card); padding: 16px 16px 14px; display: flex; flex-direction: column; gap: 10px; }
  .nm { font-size: 18px; font-weight: 600; color: var(--text-heading); margin: 0; }
  svg { width: 100%; height: auto; display: block; background: var(--page); border-radius: 8px; padding: 6px; box-sizing: border-box; }
  polyline { fill: none; stroke: var(--rose); stroke-width: 3; stroke-linejoin: round; stroke-linecap: round; }
  ul { margin: 0; padding-left: 18px; font-size: 16px; line-height: 1.5; color: var(--text-soft); }
  .fit { margin: 0; font-size: 13px; color: var(--up-on-black); }
  .cap { font-size: 14px; color: var(--text-muted); margin-top: 12px; line-height: 1.5; }
  @media (max-width: 560px) { .cards { grid-template-columns: 1fr; } }
</style>
