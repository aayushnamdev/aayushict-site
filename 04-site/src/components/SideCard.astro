---
// Linked card on black. Label (Macro / Futures), title, body.
interface Props { href: string; label: string; title: string }
const { href, label, title } = Astro.props;
---
<a class="card" href={href}>
  <div class="label">{label}</div>
  <h2>{title}</h2>
  <p><slot /></p>
</a>

<style>
  .card { display: block; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-card); padding: 24px; text-decoration: none; color: inherit; transition: border-color 0.2s; }
  @media (hover: hover) { .card:hover { border-color: var(--wine); color: inherit; } }
  .label { margin-bottom: 8px; }
  h2 { font-size: 22px; line-height: 1.3; margin-bottom: 8px; }
  p { font-size: 17px; line-height: 1.6; color: var(--text-soft); }
</style>
