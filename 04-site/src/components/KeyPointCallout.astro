---
interface Props {
  label?: string;
}
const { label = 'What most people miss' } = Astro.props;
---

<div class="callout">
  <p class="callout-label">{label}</p>
  <div class="callout-body">
    <slot />
  </div>
</div>

<style>
  .callout {
    border-left: 3px solid var(--accent);
    background: var(--surface-muted);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 1rem 1.25rem;
    margin: 0 0 1.75rem;
  }
  .callout-label {
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--accent);
    margin: 0 0 0.4rem;
  }
  .callout-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
