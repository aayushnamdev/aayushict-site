---
import CodePill from './CodePill.astro';
import type { Partner } from '../data/partners';

interface Props {
  partner: Partner;
  compact?: boolean;
}
const { partner, compact = false } = Astro.props;

const statusLabel: Record<string, string> = {
  'trade-funded': 'I trade funded here',
  'used-to': 'I used to trade here',
  recommend: 'Recommend only',
};
---

<div class:list={['affiliate-card', 'card', { compact }]}>
  <div class="affiliate-head">
    <h3>{partner.name}</h3>
    {partner.status && <span class="badge">{statusLabel[partner.status]}</span>}
  </div>
  <p class="for-what">{partner.forWhat}</p>

  {!compact && (partner.pros.length > 0 || partner.cons.length > 0) && (
    <div class="pros-cons">
      <div>
        <p class="pc-label">Pros</p>
        <ul>{partner.pros.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div>
        <p class="pc-label">Cons</p>
        <ul>{partner.cons.map((c) => <li>{c}</li>)}</ul>
      </div>
    </div>
  )}

  <div class="affiliate-footer">
    {partner.code && (
      <div class="code-row">
        <CodePill code={partner.code} />
        {partner.discount && <span class="discount">{partner.discount}</span>}
      </div>
    )}
    <a href={`/go/${partner.slug}`} class="btn btn-cta" rel="sponsored nofollow noopener">
      Go to {partner.name}
    </a>
  </div>

  <p class="disclosure-line">
    Affiliate link. The code may get you a discount, and I get a commission. It does not
    change what I write.
  </p>
  {partner.lastVerified && <p class="last-verified">Last verified {partner.lastVerified}</p>}
</div>

<style>
  .affiliate-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .affiliate-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .affiliate-head h3 {
    margin: 0;
  }
  .for-what {
    color: var(--text-muted);
    margin: 0;
  }
  .pros-cons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .pc-label {
    font-weight: 600;
    font-size: 0.85rem;
    margin: 0 0 0.3rem;
  }
  .pros-cons ul {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .affiliate-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
  .code-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .discount {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .disclosure-line {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0.25rem 0 0;
  }
  .last-verified {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: 0;
  }
</style>
