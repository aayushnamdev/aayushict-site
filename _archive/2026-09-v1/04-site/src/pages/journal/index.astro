---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('journal')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const calls = entries.filter((e) => e.data.kind === 'call');
const totals = {
  hit: calls.filter((c) => c.data.status === 'hit').length,
  invalidated: calls.filter((c) => c.data.status === 'invalidated').length,
  open: calls.filter((c) => c.data.status === 'open').length,
  dropped: calls.filter((c) => c.data.status === 'dropped').length,
};

const statusLabel: Record<string, string> = {
  hit: 'Hit',
  invalidated: 'Invalidated',
  open: 'Open',
  dropped: 'Dropped',
};
---

<BaseLayout title="Journal · Aayush ICT" description="Real calls and NQ trading days, dated. Losing calls stay up.">
  <section class="container measure header-section">
    <h1>Journal</h1>
    <p>Calls from the Macro Desk, and NQ trading days. I never delete a losing call.</p>
  </section>

  <section class="container measure totals-section">
    <div class="totals card">
      <div><span class="mono total-num">{totals.hit}</span><span class="total-label">Hit</span></div>
      <div><span class="mono total-num">{totals.invalidated}</span><span class="total-label">Invalidated</span></div>
      <div><span class="mono total-num">{totals.open}</span><span class="total-label">Open</span></div>
      <div><span class="mono total-num">{totals.dropped}</span><span class="total-label">Dropped</span></div>
    </div>
  </section>

  <section class="container measure">
    <ul class="entry-list">
      {entries.map((e) => (
        <li class="card">
          <div class="entry-top">
            <span class="badge">{e.data.kind === 'call' ? 'Call' : 'Trading day'}</span>
            {e.data.kind === 'call' && <span class="badge status">{statusLabel[e.data.status]}</span>}
            <span class="date mono">{e.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
          </div>
          <h2><a href={`/journal/${e.id}`}>{e.data.title ?? `${e.data.asset ?? ''} ${e.data.kind}`}</a></h2>
        </li>
      ))}
    </ul>
    {entries.length === 0 && <p>First journal entry is coming.</p>}
  </section>
</BaseLayout>

<style>
  .header-section {
    padding: 3rem 0 1.5rem;
  }
  .totals-section {
    margin-bottom: 1.5rem;
  }
  .totals {
    display: flex;
    justify-content: space-around;
    text-align: center;
  }
  .totals > div {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .total-num {
    font-size: 1.5rem;
    font-weight: 700;
  }
  .total-label {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .entry-list {
    list-style: none;
    margin: 0 0 3rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .entry-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .entry-top .date {
    margin-left: auto;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .entry-list h2 {
    margin: 0;
    font-size: 1.2rem;
  }
  .entry-list a {
    text-decoration: none;
    color: var(--text);
    text-transform: capitalize;
  }
  .entry-list a:hover {
    color: var(--accent);
  }
</style>
